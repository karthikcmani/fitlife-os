# FITLIFE OS — Self-Hosting Environment Configuration Template
# Copy this file to .env and replace placeholders with secure random strings

# Domain for automatic HTTPS with Caddy (e.g., fitlife.yourdomain.com or localhost)
FITLIFE_DOMAIN=localhost

# PostgreSQL Database Configuration
POSTGRES_USER=fitlife
POSTGRES_PASSWORD=replace_with_strong_password_minimum_32_chars
POSTGRES_DB=fitlife_db

# Cryptographic Secrets (minimum 64 characters random)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex_for_jwt
REFRESH_SECRET=replace_with_64_char_random_hex_for_refresh
